{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tryum_db;Username=tryum;Password=tryum_pass"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "tryum-api",
    "Audience": "tryum-web",
    "SecretKey": "",
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "https://tryum.pages.dev" ]
  },
  "Auth": {
    "DemoOtpInResponse": true
  }
}