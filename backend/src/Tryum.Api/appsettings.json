{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tryum_db;Username=tryum;Password=tryum_pass"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "tryum-api",
    "Audience": "tryum-web",
    "SecretKey": "",
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "https://tryum.pages.dev" ]
  },
  "Auth": {
    "DemoOtpInResponse": false
  },
  "Captcha": {
    "TtlSeconds": 300,
    "Required": true
  },
  "Otp": {
    "TtlSeconds": 300,
    "CooldownSeconds": 30,
    "MaxAttempts": 5,
    "MaxSendsPerDay": 5
  },
  "Sms": {
    "Provider": "SmsGate",
    "SmsGate": {
      "SendUrl": "https://api.sms-gate.app/3rdparty/v1/messages",
      "Username": "",
      "Password": "",
      "SimNumber": 1,
      "WithDeliveryReport": false,
      "TimeoutSeconds": 10
    },
    "Textbee": {
      "ApiKey": "",
      "SendUrl": "https://api.textbee.dev/api/v1/gateway/send-sms",
      "DeviceId": "",
      "SimSubscriptionId": null,
      "TimeoutSeconds": 15
    }
  }
}