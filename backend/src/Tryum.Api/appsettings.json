{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tryum_db;Username=tryum;Password=tryum_pass"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "tryum-api",
    "Audience": "tryum-web",
    "SecretKey": "",
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "https://tryum.pages.dev" ]
  },
  "Auth": {
    "DemoOtpInResponse": false
  },
  "Captcha": {
    "TtlSeconds": 300,
    "Required": true
  },
  "Otp": {
    "TtlSeconds": 300,
    "CooldownSeconds": 30,
    "MaxAttempts": 5,
    "MaxSendsPerDay": 5
  },
  "Sms": {
    "Provider": "SmsGate",
    "SmsGate": {
      "SendUrl": "https://api.sms-gate.app/3rdparty/v1/messages",
      "Username": "",
      "Password": "",
      "SimNumber": 1,
      "WithDeliveryReport": false,
      "TimeoutSeconds": 10
    },
    "Textbee": {
      "ApiKey": "",
      "SendUrl": "https://api.textbee.dev/api/v1/gateway/send-sms",
      "DeviceId": "",
      "SimSubscriptionId": null,
      "TimeoutSeconds": 15
    }
  },
  "SePay": {
    "WebhookSecret": "",
    "ApiKey": "",
    "BankBin": "",
    "BankName": "",
    "AccountNumber": "",
    "AccountName": "",
    "VietQrTemplate": "compact2",
    "PublicApiUrl": "",
    "TimestampToleranceSeconds": 300,
    "AllowSimulation": false
  },
  "Goship": {
    "BaseUrl": "https://sandbox.goship.io/api/v2",
    "AccessToken": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "AI": {
    "GroqApiKey": "",
    "GroqBaseUrl": "https://api.groq.com/openai/v1",
    "GroqModel": "openai/gpt-oss-120b",
    "GeminiApiKey": "",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "GeminiModel": "gemini-3.6-flash"
  },
  "Redis": {
    "Host": "",
    "Port": 6379,
    "Password": "",
    "Ssl": true,
    "Prefix": "tryum:"
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5671,
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "Ssl": true,
    "Exchange": "tryum.events"
  },
  "OpenTelemetry": {
    "Endpoint": "",
    "Headers": "",
    "ServiceName": "tryum-api",
    "ServiceNamespace": "tryum",
    "Environment": "production"
  },
  "Metrics": {
    "Token": ""
  }
}