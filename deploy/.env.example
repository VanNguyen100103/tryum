# Copy file này thành .env rồi điền giá trị thật. .env KHÔNG được commit.
#   cp deploy/.env.example deploy/.env

# ── Domain ───────────────────────────────────────────────────────────────────
# Dry-run local:
API_DOMAIN=localhost
ACME_EMAIL=admin@example.com
# Production (sau khi có DuckDNS):
# API_DOMAIN=tryum-api.duckdns.org
# ACME_EMAIL=ban@tenmien.com

API_PUBLIC_URL=https://localhost:7080
WEB_ORIGIN=https://localhost:7080
# Origin thứ 2 (tuỳ chọn) – ví dụ UI trên Cloudflare Pages/Workers:
# WEB_ORIGIN_1=https://tryum-web.nganhvan1609.workers.dev

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=tryum_db
POSTGRES_USER=tryum
POSTGRES_PASSWORD=doi-mat-khau-nhanh_vao_day

# ── JWT ──────────────────────────────────────────────────────────────────────
# Sinh key mới:  openssl rand -base64 32
JWT_ISSUER=tryum-api
JWT_AUDIENCE=tryum-web
JWT_SECRET_KEY=
JWT_EXPIRES_IN_MINUTES=60
JWT_REFRESH_EXPIRES_IN_DAYS=30

# ── SMS (self-host, MIỄN PHÍ – https://sms-gate.app) ─────────────────────────
# Biến một điện thoại Android thành SMS gateway: không phí thuê bao, không brandname.
# SMS_PROVIDER=Log      → chỉ ghi log (dev, 0đ)
# SMS_PROVIDER=SmsGate  → gửi SMS thật qua điện thoại Android
SMS_PROVIDER=SmsGate
# Cloud (mọi nơi): https://api.sms-gate.app/3rdparty/v1/messages
# Local (cùng Wi-Fi): http://<ip-dien-thoai>:8080/message
SMS_GATE_URL=https://api.sms-gate.app/3rdparty/v1/messages
# Tài khoản Basic auth đặt trong app SMSGate trên điện thoại.
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
# Chọn SIM khi máy nhiều SIM (1-based).
SMS_GATE_SIM=1
# Trả OTP trong response API? Production NÊN false (gửi SMS thật, không lộ mã).
DEMO_OTP_IN_RESPONSE=false

# ── Khác ─────────────────────────────────────────────────────────────────────
# Migrate + seed lúc API start (tắt khi đã có CI/CD chạy migration).
APPLY_MIGRATIONS_ON_STARTUP=true
HTTP_PORT=80
HTTPS_PORT=7080

# Kiến trúc image: Oracle Ampere A1 = arm64, máy local thường là amd64.
# Build trên máy local rồi đẩy sang VM thì để đúng arch của VM.
TARGET_PLATFORM=linux/arm64

# Tên image (tuỳ chọn – dùng khi muốn đẩy lên GHCR)
# API_IMAGE=ghcr.io/<user>/tryum-api:latest
# WEB_IMAGE=ghcr.io/<user>/tryum-web:latest