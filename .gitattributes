# ── EOL ────────────────────────────────────────────────────────────────────
# Script chạy trong container/VM (bash entrypoint của nginx) BẮT BUỘC phải là LF.
# Nếu là CRLF thì shebang "#!/bin/sh\r" không tìm được interpreter => container
# restart loop với lỗi "40-tryum-config.sh: not found".
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Mặc định: text file trong repo lưu LF, checkout trên Windows vẫn CRLF nếu muốn
* text=auto

# Nhị phân: không đụng tới
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.tar binary
*.tar.gz binary
*.zip binary